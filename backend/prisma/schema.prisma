datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  RECEPTIONIST
  DOCTOR
}

enum AppointmentStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum QueueStatus {
  WAITING
  CALLING
  COMPLETED
  SKIPPED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(RECEPTIONIST)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  doctorProfile Doctor? @relation("UserDoctor")
}

model Doctor {
  id               String       @id @default(cuid())
  userId           String?      @unique
  name             String
  specialization   String
  department       String
  consultationFee  Int
  experience       Int
  startTime        String
  endTime          String
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  user             User?        @relation("UserDoctor", fields: [userId], references: [id])
  appointments     Appointment[]
  queueTokens      QueueToken[]
}

model Patient {
  id              String       @id @default(cuid())
  name            String
  email           String?
  phoneNumber     String
  age             Int
  gender          Gender
  medicalHistory  String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  appointments    Appointment[]
  queueTokens     QueueToken[]
}

model Appointment {
  id               String            @id @default(cuid())
  patientId        String
  doctorId         String
  appointmentDate  DateTime
  reason           String
  status           AppointmentStatus @default(PENDING)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  patient          Patient           @relation(fields: [patientId], references: [id])
  doctor           Doctor            @relation(fields: [doctorId], references: [id])
  queueTokens      QueueToken[]

  @@unique([doctorId, appointmentDate])
  @@index([patientId])
  @@index([doctorId])
  @@index([status])
  @@index([appointmentDate])
}

model QueueToken {
  id            String      @id @default(cuid())
  tokenNumber   Int
  patientId     String
  doctorId      String
  appointmentId String?
  status        QueueStatus @default(WAITING)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  patient       Patient     @relation(fields: [patientId], references: [id])
  doctor        Doctor      @relation(fields: [doctorId], references: [id])
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])

  @@index([patientId])
  @@index([doctorId])
  @@index([status])
  @@index([createdAt])
}
